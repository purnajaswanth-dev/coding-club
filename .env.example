# Copy this file to .env and adjust.

# true  = use the mock data in src/data (no backend needed)
# false = call the real backend at VITE_API_URL
VITE_USE_MOCK=true

# Base URL of your backend REST API (Spring Boot, Node, Django...)
VITE_API_URL=http://localhost:8080/api

# true = hash URLs (/#/events). Use for static hosting without server rewrites.
VITE_HASH_ROUTER=false
